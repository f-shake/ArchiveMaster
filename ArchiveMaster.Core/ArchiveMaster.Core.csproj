<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ArchiveMaster</RootNamespace>     
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaXaml Remove="obj\**" />
    <Compile Remove="obj\**" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="obj\**" />
    <Compile Update="Views\ProgressDialog.axaml.cs">
      <DependentUpon>ProgressDialog.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\TwoStepPanelBase.axaml.cs">
      <DependentUpon>OfflineSyncPanelBase.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\FilePickerAndFilter\FileFilterBar.axaml.cs">
      <DependentUpon>FileFilterBar.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\FilePickerAndFilter\FileFilterControl.axaml.cs">
      <DependentUpon>FileFilterControl.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\FilePickerAndFilter\FileFilterPanel.axaml.cs">
      <DependentUpon>FileFilterPanel.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\FilePickerAndFilter\FilePickerTextBox.axaml.cs">
      <DependentUpon>FilePickerTextBox.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\FilePickerAndFilter\FilterTestResultDialog.axaml.cs">
      <DependentUpon>FilterTestResultDialog.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>



  <ItemGroup>
    <PackageReference Include="FluentIcons.Avalonia" />
    <!-- GeneratePathProperty：把包内自带的 Notice.txt（约 400 KB，含全部第三方组件许可）随包分发。
         Apache-2.0 §4(d) 要求传递其归属声明，而 Magick.NET 的 targets 只复制原生库、不复制该文件。 -->
    <PackageReference Include="Magick.NET-Q16-AnyCPU" GeneratePathProperty="true" />
    <PackageReference Include="Mapster" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(PkgMagick_NET-Q16-AnyCPU)\Notice.txt')">
    <!-- NuGet 生成的路径属性名只把包名里的 . 换成 _，连字符保留 -->
    <Content Include="$(PkgMagick_NET-Q16-AnyCPU)\Notice.txt">
      <Link>NOTICE-Magick.NET.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\PanelBase.axaml.cs">
      <DependentUpon>%(Filename)</DependentUpon>
    </Compile>
    <Compile Update="Views\TwoStepPanelBase.axaml.cs">
      <DependentUpon>TwoStepPanelBase.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\TwoStepPanelBase.axaml.cs">
      <SubType>Code</SubType>
      <DependentUpon>%(Filename)</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Views\TwoStepPanelBase.axaml">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

</Project>
